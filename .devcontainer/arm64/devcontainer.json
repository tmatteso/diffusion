{
  "name": "PyTorch Dev Container (ARM64/M1)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "${localWorkspaceFolder}",
    "args": {
      "PLATFORM": "arm64"
    }
  },
  "workspaceFolder": "/workspaces/diffusion",
  "mounts": [
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind"
  ],
  "remoteEnv": {
    "VIRTUAL_ENV": "/opt/venv",
    "PATH": "/opt/venv/bin:${containerEnv:PATH}",
    "PYTHONPATH": "/workspaces/diffusion",
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.debugpy",
        "detachhead.basedpyright",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    },
    "cursor": {
      "extensions": [
        "ms-python.debugpy",
        "detachhead.basedpyright",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "postCreateCommand": "python -m ipykernel install --user --name=diffusion --display-name='Python (diffusion)' && echo 'source /opt/venv/bin/activate' >> ~/.bashrc && show-platform",
  "remoteUser": "root"
}

