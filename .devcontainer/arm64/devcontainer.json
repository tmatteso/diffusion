{
  "name": "PyTorch Dev Container (ARM64/M1)",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "PLATFORM": "arm64"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "uv sync && show-platform",
  "remoteUser": "root"
}
