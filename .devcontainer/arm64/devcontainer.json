{
  "name": "PyTorch Dev Container (ARM64/M1)",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "PLATFORM": "arm64"
    }
  },
  "workspaceFolder": "/workspaces/diffusion",
  "remoteEnv": {
    "VIRTUAL_ENV": "/workspaces/diffusion/.venv",
    "PATH": "/workspaces/diffusion/.venv/bin:${containerEnv:PATH}",
    "PYTHONPATH": "/workspaces/diffusion",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/diffusion/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    },
    "cursor": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/diffusion/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "postCreateCommand": "cd /workspaces/diffusion && rm -f uv.lock && uv lock && uv sync && python -m ipykernel install --user --name=diffusion --display-name='Python (diffusion)' && echo 'source /workspaces/diffusion/.venv/bin/activate' >> ~/.bashrc && show-platform",
  "remoteUser": "root"
}
