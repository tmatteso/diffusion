{
  "name": "PyTorch Dev Container (CUDA)",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "PLATFORM": "cuda"
    }
  },
  "workspaceFolder": "/workspaces/diffusion",
  "remoteEnv": {
    "VIRTUAL_ENV": "/workspaces/diffusion/.venv",
    "PATH": "/workspaces/diffusion/.venv/bin:${containerEnv:PATH}",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "runArgs": [
    "--gpus=all"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/diffusion/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "postCreateCommand": "cd /workspaces/diffusion && uv sync && echo 'source /workspaces/diffusion/.venv/bin/activate' >> ~/.bashrc && show-platform",
  "remoteUser": "root"
}
