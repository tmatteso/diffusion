{
  "name": "PyTorch Dev Container (CUDA)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "${localWorkspaceFolder}",
    "args": {
      "PLATFORM": "cuda"
    }
  },
  "workspaceFolder": "/workspaces/diffusion",
  "remoteEnv": {
    "VIRTUAL_ENV": "/opt/venv",
    "PATH": "/opt/venv/bin:${containerEnv:PATH}"
  },
  "runArgs": [
    "--gpus=all",
    "--shm-size=8g"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.debugpy",
        "detachhead.basedpyright",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "postCreateCommand": "echo 'source /opt/venv/bin/activate' >> ~/.bashrc && show-platform",
  "remoteUser": "root"
}

